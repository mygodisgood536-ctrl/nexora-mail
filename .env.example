# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Platform domain (must match Cloudflare Email Routing domain)
PLATFORM_DOMAIN=yourdomain.com
NEXT_PUBLIC_PLATFORM_DOMAIN=yourdomain.com

# Optional: Cloudflare R2 (for message content storage)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=nexora-messages

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
