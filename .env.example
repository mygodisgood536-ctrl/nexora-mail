# ── Required: Neon PostgreSQL ────────────────────────────────────────────────
# Pooled connection string (use the pooled endpoint, with ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Required: Auth ───────────────────────────────────────────────────────────
# At least 32 random characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ── Required: Platform domain (must match Cloudflare Email Routing) ──────────
PLATFORM_DOMAIN=yourdomain.com
NEXT_PUBLIC_PLATFORM_DOMAIN=yourdomain.com
NEXT_PUBLIC_APP_URL=https://your-vercel-app.vercel.app

# ── Required for production: account verification / security notifications ──
# Resend API key + a verified "from" address in Resend.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Nexora Mail <security@yourdomain.com>

# ── Required for message detail + manual/expiry deletion from the app ───────
# Cloudflare R2 S3 API token (Object Read & Write on the messages bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nexora-messages

# ── Cloudflare Worker (set with `wrangler secret put DATABASE_URL`) ──────────
# DATABASE_URL (same Neon connection string, provided as a Worker secret)
# PLATFORM_DOMAIN is set in wrangler.toml
